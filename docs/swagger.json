{
  "openapi": "3.1.0",
  "info": {
    "title": "Contacts API",
    "version": "1.0.0",
    "description": "API for managing contacts"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    },
    {
      "url": "https://contacts-app-ppc1.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Operations related to contacts"
    },
    {
      "name": "Auth",
      "description": "Operations related to authentication"
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get all contacts",
        "operationId": "getContacts",
        "description": "Retrieves a list of all contacts from the database with support for pagination, sorting and filtering.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Page number to retrieve (default is 1)."
          },
          {
            "in": "query",
            "name": "perPage",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "description": "Number of items per page (default is 10)."
          },
          {
            "in": "query",
            "name": "sortBy",
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "phoneNumber",
                "email",
                "contactType",
                "isFavourite"
              ]
            },
            "description": "Field to sort by."
          },
          {
            "in": "query",
            "name": "sortOrder",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "description": "Sort order (asc for ascending, desc for descending)."
          },
          {
            "in": "query",
            "name": "filter",
            "style": "deepObject",
            "schema": {
              "type": "object",
              "properties": {
                "isFavourite": {
                  "type": "boolean"
                },
                "contactType": {
                  "type": "string",
                  "enum": [
                    "work",
                    "home",
                    "personal"
                  ]
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved contacts!",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully retrieved contacts!"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/contact"
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "perPage": {
                          "type": "integer"
                        },
                        "totalItems": {
                          "type": "integer"
                        },
                        "totalPages": {
                          "type": "integer"
                        },
                        "hasPreviousPage": {
                          "type": "boolean"
                        },
                        "hasNextPage": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 401
                    },
                    "message": {
                      "type": "string",
                      "example": "Unauthorized"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Create a new contact",
        "operationId": "createContact",
        "description": "Creates a new contact in the database.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/contact-create"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successfully created a new contact!",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully created a new contact!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/contact"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 400
                    },
                    "message": {
                      "type": "string",
                      "example": "Bad Request"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 401
                    },
                    "message": {
                      "type": "string",
                      "example": "Unauthorized"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "patch": {
          "tags": [
            "Contacts"
          ],
          "summary": "Update contact by id",
          "operationId": "updateContact",
          "description": "Update an existing contact by id",
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "parameters": [
            {
              "in": "path",
              "name": "contactId",
              "required": true,
              "schema": {
                "type": "string",
                "example": "65ca67e7ae7f10c88b598384"
              }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "multipart/form-data": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "example": "John Doe"
                    },
                    "phoneNumber": {
                      "type": "string",
                      "example": "+380200000000"
                    },
                    "email": {
                      "type": "string",
                      "example": "jon.doe@mail.com"
                    },
                    "isFavourite": {
                      "type": "boolean",
                      "example": true
                    },
                    "contactType": {
                      "type": "string",
                      "enum": [
                        "work",
                        "home",
                        "personal"
                      ],
                      "example": "work"
                    },
                    "photo": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Successfully patched a contact",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "required": [
                      "status",
                      "message",
                      "data"
                    ],
                    "properties": {
                      "status": {
                        "type": "integer",
                        "example": 200
                      },
                      "message": {
                        "type": "string",
                        "example": "Successfully patched a contact!"
                      },
                      "data": {
                        "$ref": "../../../components/schemas/contact.yaml"
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "$ref": "../../../components/responses/401.yaml"
            },
            "404": {
              "$ref": "../../../components/responses/404.yaml"
            },
            "422": {
              "$ref": "../../../components/responses/422.yaml"
            }
          }
        }
      },
      "delete": {
        "delete": {
          "tags": [
            "Contacts"
          ],
          "summary": "Delete contact by id",
          "operationId": "deleteContact",
          "description": "Delete an existing contact by id",
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "parameters": [
            {
              "in": "path",
              "name": "contactId",
              "required": true,
              "schema": {
                "type": "string",
                "example": "65ca67e7ae7f10c88b598384"
              }
            }
          ],
          "responses": {
            "204": {
              "description": "No Content"
            },
            "401": {
              "$ref": "../../../components/responses/401.yaml"
            },
            "404": {
              "$ref": "../../../components/responses/404.yaml"
            }
          }
        }
      }
    },
    "/auth": {
      "/auth/register": {
        "$ref": "./register.yaml"
      },
      "/auth/login": {
        "$ref": "./login.yaml"
      },
      "/auth/refresh": {
        "$ref": "./refresh.yaml"
      },
      "/auth/logout": {
        "$ref": "./logout.yaml"
      },
      "/auth/send-reset-email": {
        "$ref": "./send-reset-email.yaml"
      },
      "/auth/reset-pwd": {
        "$ref": "./reset-pwd.yaml"
      },
      "/auth/get-current": {
        "$ref": "./get-current.yaml"
      },
      "/auth/google/oauth": {
        "$ref": "./google-oauth.yaml"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "contact": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "65ca67e7ae7f10c88b598384"
          },
          "name": {
            "type": "string",
            "example": "Jane Doe"
          },
          "phoneNumber": {
            "type": "string",
            "example": "+380200000000"
          },
          "email": {
            "type": "string",
            "example": "jane.doe@mail.com"
          },
          "isFavourite": {
            "type": "boolean",
            "example": true
          },
          "contactType": {
            "type": "string",
            "enum": [
              "work",
              "home",
              "personal"
            ],
            "example": "work"
          },
          "ownerId": {
            "type": "string",
            "example": "65ca67e7ae7f10c88b598385"
          },
          "photo": {
            "type": "string",
            "example": "https://res.cloudinary.com/.../contacts/photo/"
          },
          "createdAt": {
            "type": "string",
            "example": "2024-05-23T10:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2024-05-23T10:00:00.000Z"
          }
        }
      },
      "contact-create": {
        "type": "object",
        "required": [
          "name",
          "phoneNumber",
          "email",
          "contactType"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "phoneNumber": {
            "type": "string",
            "example": "+380200000000"
          },
          "email": {
            "type": "string",
            "example": "jon.doe@mail.com"
          },
          "isFavourite": {
            "type": "boolean",
            "example": true
          },
          "contactType": {
            "type": "string",
            "enum": [
              "work",
              "home",
              "personal"
            ],
            "example": "work"
          }
        }
      },
      "contact-update": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "phoneNumber": {
            "type": "string",
            "example": "+380200000000"
          },
          "email": {
            "type": "string",
            "example": "jon.doe@mail.com"
          },
          "isFavourite": {
            "type": "boolean",
            "example": true
          },
          "contactType": {
            "type": "string",
            "enum": [
              "work",
              "home",
              "personal"
            ],
            "example": "work"
          },
          "photo": {
            "type": "string",
            "format": "binary"
          }
        }
      },
      "auth-login": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "example": "example@example.com"
          },
          "password": {
            "type": "string",
            "example": "examplePassword123"
          }
        }
      },
      "auth-register": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "example": "example@example.com"
          },
          "password": {
            "type": "string",
            "example": "examplePassword123"
          }
        }
      },
      "auth-reset-email": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "example": "example@example.com"
          }
        }
      },
      "auth-reset-pwd": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "example": "examplePassword123"
          }
        }
      },
      "google-auth": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "4%2F0AZsmQ_example"
          }
        }
      },
      "tokens-response": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjY1Y2E2N2U3YWU3ZjEwYzg4YjU5ODM4NCIsImlhdCI6MTcxOTk1MjA1NSwiZXhwIjoxNzE5OTU1NjU1fQ.Xq2j8H2d..."
          },
          "refreshToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjY1Y2E2N2U3YWU3ZjEwYzg4YjU5ODM4NCIsImlhdCI6MTcxOTk1MjA1NSwiZXhwIjoxNzI3NzI4MDU1fQ.xV5K1K1K..."
          }
        }
      },
      "user-info": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "65ca67e7ae7f10c88b598384"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "example": "example@example.com"
          }
        }
      },
      "contactCreate": {
        "$ref": "#/components/schemas/contact-create"
      },
      "contactUpdate": {
        "$ref": "#/components/schemas/contact-update"
      },
      "authLogin": {
        "$ref": "#/components/schemas/auth-login"
      },
      "authRegister": {
        "$ref": "#/components/schemas/auth-register"
      },
      "authResetEmail": {
        "$ref": "#/components/schemas/auth-reset-email"
      },
      "authResetPwd": {
        "$ref": "#/components/schemas/auth-reset-pwd"
      },
      "googleAuth": {
        "$ref": "#/components/schemas/google-auth"
      },
      "tokensResponse": {
        "$ref": "#/components/schemas/tokens-response"
      },
      "userInfo": {
        "$ref": "#/components/schemas/user-info"
      }
    }
  }
}